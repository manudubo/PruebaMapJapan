kc_url        = "http://localhost:8080"
kc_admin_user = "admin"
kc_admin_pass = "REPLACE_WITH_ADMIN_PASSWORD"

# profile = "local" (default): test users, localhost redirects, Mailpit SMTP.
# Production uses production.tfvars.example instead (keycloak/README.md section 4).

# SEC-17: keep "external" locally (plain HTTP). Production: "all" — see keycloak/README.md.
ssl_required = "external"

# Playwright test users (SEC-19: no defaults in variables.tf — set them here).
# Must satisfy the realm password policy: >= 8 chars, 1 uppercase, 1 digit, 1 special.
# Mirror the values in tests/.env.test (E2E_*_PASSWORD).
e2e_test_password            = "REPLACE_ME"
e2e_otp_password             = "REPLACE_ME"
testuser_password            = "REPLACE_ME"
new_user_test_password       = "REPLACE_ME"
trip_edit_test_user_password = "REPLACE_ME"
e2e_session_password         = "REPLACE_ME"
