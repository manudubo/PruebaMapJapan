# DB driver (ARCH-02): "pg" = node-postgres/TCP (local Postgres), "neon" = Neon HTTP.
DB_DRIVER=pg
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=japan-trip
VALID_AUDIENCES=japan-trip-frontend
KC_ADMIN_CLIENT_ID=japan-trip-worker
KC_ADMIN_CLIENT_SECRET=replace-with-local-uuid
# OTP_SECRET: random hex string for HMAC-SHA256 OTP hashing.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# For prod: wrangler secret put OTP_SECRET
OTP_SECRET=replace-with-64-char-hex
# ENVIRONMENT=development allows localhost CORS origins and the Mailpit OTP
# email fallback. Any other value (or unset under wrangler) is treated as
# production, where a missing RESEND_API_KEY makes otp-request fail loudly.
ENVIRONMENT=development

# OTP email provider (SEC-08). Unset in development = local Mailpit.
# Production needs ONE of:
#   RESEND_API_KEY=re_...            (needs a domain verified in Resend)
#   SMTP, e.g. Gmail + app password  (no domain needed; Node backend only):
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=starttls             # or SMTP_PORT=465 with SMTP_SECURE=tls
# SMTP_USER=you@gmail.com
# SMTP_PASS=                       # 16-char app password; never commit it
# EMAIL_FROM=TravelMap <you@gmail.com>
#
# Internet exposure (see .planning/qa/PROD-HARDENING.md):
# ALLOWED_ORIGINS=https://manudubo.github.io
# TRUSTED_PROXY_HOPS=0             # Tailscale Funnel -> Caddy -> app: 2
# CLIENT_IP_HEADER=x-forwarded-for
# KEYCLOAK_JWKS_URL=               # optional internal JWKS URL
# NOMINATIM_CONTACT=               # contact email/URL for the OSM usage policy
