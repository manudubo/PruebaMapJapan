# TEST ONLY: plays the role of Tailscale Funnel (TLS for PUBLIC_HOST, then
# plain HTTP to the stack's proxy on 127.0.0.1:PROXY_PORT).
{
	admin off
	auto_https disable_redirects
	local_certs
	http_port 38099
	https_port {$TEST_TLS_PORT}
	# Append to X-Forwarded-For like tailscale serve (Go's ReverseProxy) does,
	# instead of Caddy's default of replacing it for untrusted clients.
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

{$PUBLIC_HOST} {
	tls internal
	reverse_proxy 127.0.0.1:{$PROXY_PORT}
}
