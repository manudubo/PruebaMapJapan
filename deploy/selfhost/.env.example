# TravelMap self-hosting settings. See docs/SELF-HOSTING.md.
#
#   cp .env.example .env && chmod 600 .env
#   ./scripts/gen-secrets.sh          # fills every CHANGE_ME_SECRET below
#
# NEVER commit .env (deploy/selfhost/.gitignore already ignores it).
# Values are plain KEY=value: no quotes needed, no spaces around "=".

# ---------------------------------------------------------------------------
# 1. How the server is reached from the internet
# ---------------------------------------------------------------------------
# single-host (default): ONE https hostname, path routing
#     https://PUBLIC_HOST/api/...   -> backend
#     https://PUBLIC_HOST/auth/...  -> Keycloak
#   Works with Tailscale Funnel: free, no domain, no router ports.
# subdomains: your own domain on Cloudflare DNS
#     https://api.DOMAIN/api/...    -> backend
#     https://auth.DOMAIN/auth/...  -> Keycloak
HOST_MODE=single-host

# single-host: the Funnel name of this machine, e.g. legion.tail1234.ts.net
# (find it with: tailscale status --json | jq -r .Self.DNSName  - drop the final dot)
# WARNING: passkeys are bound to this name. Renaming the machine or the tailnet
# later makes every registered passkey stop working (users sign in with a
# password or email code and register a new passkey).
PUBLIC_HOST=legion-server.tailad4a36.ts.net

# subdomains: your domain, e.g. example.com (api.example.com + auth.example.com)
DOMAIN=

# How traffic gets in:
#   funnel      - Tailscale Funnel (single-host only; default for single-host)
#   cloudflared - Cloudflare Tunnel (subdomains; default for subdomains)
#   caddy       - Caddy gets Let's Encrypt certs itself; needs ports 80+443
#                 forwarded on your router (subdomains only)
INGRESS=
# cloudflared only: the tunnel token from the Cloudflare dashboard
# (Zero Trust -> Networks -> Tunnels -> your tunnel -> Docker command, the part after --token)
CLOUDFLARE_TUNNEL_TOKEN=
# caddy only: email Let's Encrypt uses for expiry notices
ACME_EMAIL=

# Local port the reverse proxy listens on (127.0.0.1 only; Funnel points here).
PROXY_PORT=28080
# Local port for the Keycloak admin console (127.0.0.1 only; reach it with an
# SSH tunnel: ssh -L 28081:127.0.0.1:28081 you@server, then http://localhost:28081/auth/admin/)
KC_ADMIN_PORT=28081

# ---------------------------------------------------------------------------
# 2. The frontend (GitHub Pages) that calls this server
# ---------------------------------------------------------------------------
FRONTEND_ORIGIN=https://manudubo.github.io
FRONTEND_BASE_PATH=/PruebaMapJapan

# ---------------------------------------------------------------------------
# 3. Secrets (generated by ./scripts/gen-secrets.sh - do not invent them)
# ---------------------------------------------------------------------------
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_SECRET
APP_DB_PASSWORD=CHANGE_ME_SECRET
KC_DB_PASSWORD=CHANGE_ME_SECRET
KC_ADMIN_PASSWORD=CHANGE_ME_SECRET
OTP_SECRET=CHANGE_ME_SECRET

# ---------------------------------------------------------------------------
# 4. Email (sign-in codes from the backend, verification/reset from Keycloak)
# ---------------------------------------------------------------------------
# Sender shown to users. With Resend it must be on a domain you verified there;
# with Gmail it must be your Gmail address.
EMAIL_FROM=
# Backend transport: resend or smtp
EMAIL_PROVIDER=smtp
# Resend (needs your own domain verified in Resend):
RESEND_API_KEY=
# SMTP - used by Keycloak always, and by the backend when EMAIL_PROVIDER=smtp.
# SMTP_SECURE: starttls (port 587) or tls (port 465); plain SMTP is refused.
#  Gmail (no domain needed): smtp.gmail.com, 587, starttls, you@gmail.com, a Google "App password"
#  Resend SMTP:              smtp.resend.com, 465, tls, resend, your RESEND_API_KEY
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# 5. Other app settings
# ---------------------------------------------------------------------------
# OpenStreetMap Nominatim policy: identify the app and give a contact.
# NOMINATIM_CONTACT is required (an email or URL where OSM can reach you);
# NOMINATIM_USER_AGENT is optional (product name, no spaces or brackets).
NOMINATIM_USER_AGENT=TravelMap-selfhost/1.0
NOMINATIM_CONTACT=
# Reverse proxies between the internet and the backend, used to find the real
# client IP for rate limiting. Leave empty: the scripts pick the right value
# (single-host/funnel = 2, subdomains/cloudflared = 2, subdomains/caddy = 1).
TRUSTED_PROXY_HOPS=

# ---------------------------------------------------------------------------
# 6. Accounts: open sign-up and e-mail recovery (docs/SELF-HOSTING.md "Open sign-up")
# ---------------------------------------------------------------------------
# false (default): accounts only by invitation (./scripts/add-user.sh).
# true: anyone on the internet can create an account (passkey first; the address
# is proven with a 6-digit code before the API answers). Read the risks first,
# then re-run ./scripts/keycloak-apply.sh and install ./scripts/purge-timer.sh.
REGISTRATION_ENABLED=false
# Optional Google reCAPTCHA on the sign-up form (both or neither).
# The secret is passed to Terraform through the environment only.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Never-verified sign-ups are deleted after this many hours (purge-unverified.sh).
PURGE_UNVERIFIED_AFTER_HOURS=24
# Secret of the travelmap-recovery Keycloak client (manage-users only), used by
# the backend to set a password after an e-mail code. Written here by
# ./scripts/keycloak-apply.sh; do not copy it anywhere else.
KEYCLOAK_RECOVERY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# 7. Backups
# ---------------------------------------------------------------------------
# Where backups go (empty = deploy/selfhost/backups) and how many to keep.
BACKUP_DIR=
BACKUP_KEEP=14
# Optional off-site copy with rclone (configure it first with: rclone config)
# e.g. gdrive:travelmap-backups. Empty = no off-site copy.
BACKUP_RCLONE_REMOTE=

# ---------------------------------------------------------------------------
# Advanced (defaults are fine)
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=travelmap
KEYCLOAK_REALM=japan-trip
PG_POOL_MAX=10
# Backend log threshold: debug, info, warn or error.
LOG_LEVEL=info
# Self-hosted Nominatim (https). Empty = the public OSM instance.
NOMINATIM_URL=
# Only when the public issuer differs from https://PUBLIC_HOST/auth/realms/<realm>
# (e.g. Keycloak frontend_url set to another name). Empty = derived.
KEYCLOAK_ISSUER=
